---
// Portfolio/Works section - light coral theme
const projects = [
  {
    title: 'AI Chatbot Platform',
    category: 'AI Development',
    description: 'Intelligent conversational AI for customer support automation.',
  },
  {
    title: 'Data Analytics Dashboard',
    category: 'Full Stack',
    description: 'Real-time business intelligence and reporting platform.',
  },
  {
    title: 'Process Automation Suite',
    category: 'Consultancy',
    description: 'End-to-end workflow automation for enterprise clients.',
  },
];
---

<section id="portfolio" class="py-20 bg-warm-50">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-6xl">
    <!-- Section Header -->
    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4 mb-12">
      <div>
        <h2 class="text-3xl sm:text-4xl font-bold text-warm-900 mb-2">
          My Latest Works
        </h2>
        <p class="text-warm-500">
          Perfect solution for digital experience
        </p>
      </div>
      <a href="/posts" class="text-coral-link">
        View all works
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    </div>

    <!-- Projects Grid -->
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      {projects.map((project, index) => (
        <article
          class="group bg-white rounded-2xl overflow-hidden border border-warm-200 hover:border-coral-300 transition-all duration-300 hover:-translate-y-1 hover:shadow-lg hover:shadow-coral-500/10"
          style={`animation: slideUp 0.6s ease-out ${index * 100}ms backwards`}
        >
          <!-- Image placeholder -->
          <div class="aspect-[4/3] bg-gradient-to-br from-coral-50 to-coral-100 flex items-center justify-center relative overflow-hidden">
            <div class="text-center p-6">
              <div class="w-16 h-16 mx-auto mb-4 rounded-2xl bg-white/80 flex items-center justify-center shadow-sm">
                <svg class="w-8 h-8 text-coral-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                </svg>
              </div>
              <p class="text-xs text-coral-400 font-medium">Preview coming soon</p>
            </div>

            <!-- Hover overlay -->
            <div class="absolute inset-0 bg-coral-500/0 group-hover:bg-coral-500/5 transition-colors duration-300"></div>
          </div>

          <!-- Content -->
          <div class="p-5">
            <div class="flex items-center justify-between mb-2">
              <span class="text-xs text-coral-500 font-medium uppercase tracking-wide">
                {project.category}
              </span>
              <svg class="w-5 h-5 text-warm-300 group-hover:text-coral-500 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </div>
            <h3 class="text-lg font-semibold text-warm-900 group-hover:text-coral-500 transition-colors mb-2">
              {project.title}
            </h3>
            <p class="text-sm text-warm-500">
              {project.description}
            </p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  @keyframes slideUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
