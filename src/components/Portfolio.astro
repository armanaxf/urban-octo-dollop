---
// Portfolio/Works section - placeholder for future projects
const projects = [
  {
    title: 'AI Chatbot Platform',
    category: 'AI Development',
    image: null, // Placeholder
    description: 'Intelligent conversational AI for customer support automation.',
  },
  {
    title: 'Data Analytics Dashboard',
    category: 'Full Stack',
    image: null,
    description: 'Real-time business intelligence and reporting platform.',
  },
  {
    title: 'Process Automation Suite',
    category: 'Consultancy',
    image: null,
    description: 'End-to-end workflow automation for enterprise clients.',
  },
];
---

<section id="portfolio" class="py-20 bg-slate-800/30">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-6xl">
    <!-- Section Header -->
    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4 mb-12">
      <div>
        <p class="section-label flex items-center gap-2 mb-4">
          <span class="w-4 h-px bg-gray-600"></span>
          Portfolio
        </p>
        <h2 class="text-3xl sm:text-4xl font-bold text-white">
          All Creative Works,<br />
          <span class="text-gray-400">Selected projects.</span>
        </h2>
      </div>
      <p class="text-gray-400 max-w-md">
        A showcase of AI solutions, web applications, and consultancy work delivered to clients.
      </p>
    </div>

    <!-- Projects Grid -->
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      {projects.map((project, index) => (
        <article
          class="group bg-slate-800 rounded-xl overflow-hidden border border-slate-700/50 hover:border-amber-500/30 transition-all duration-300 hover:-translate-y-1"
          style={`animation: slideUp 0.6s ease-out ${index * 100}ms backwards`}
        >
          <!-- Image placeholder -->
          <div class="aspect-video bg-gradient-to-br from-slate-700 to-slate-800 flex items-center justify-center">
            <div class="text-center p-6">
              <div class="w-16 h-16 mx-auto mb-4 rounded-full bg-slate-700/50 flex items-center justify-center">
                <svg class="w-8 h-8 text-amber-500/50" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                </svg>
              </div>
              <p class="text-xs text-gray-500">Project preview coming soon</p>
            </div>
          </div>

          <!-- Content -->
          <div class="p-5">
            <div class="flex items-center justify-between mb-2">
              <span class="text-xs text-amber-500 font-medium uppercase tracking-wide">
                {project.category}
              </span>
            </div>
            <h3 class="text-lg font-semibold text-white group-hover:text-amber-500 transition-colors mb-2">
              {project.title}
            </h3>
            <p class="text-sm text-gray-400">
              {project.description}
            </p>
          </div>
        </article>
      ))}
    </div>

    <!-- Coming Soon Notice -->
    <div class="mt-12 text-center">
      <p class="text-gray-500 text-sm">
        More projects coming soon. <a href="/posts" class="text-amber-link">Read my blog</a> for insights on my work.
      </p>
    </div>
  </div>
</section>

<style>
  @keyframes slideUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
