---
// Header component - Dark freelancer style
const navItems = [
  { href: '/', label: 'Home' },
  { href: '/posts', label: 'Blog' },
  { href: '/about', label: 'About' },
];
---

<header class="fixed top-0 left-0 right-0 z-50 bg-slate-900/80 backdrop-blur-md border-b border-slate-800/50">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between max-w-6xl">
    <!-- Logo -->
    <a href="/" class="flex items-center gap-3 group">
      <div class="w-9 h-9 rounded-lg bg-amber-500 flex items-center justify-center shadow-lg shadow-amber-500/20 group-hover:shadow-amber-500/40 transition-shadow duration-300">
        <span class="text-slate-900 font-bold text-lg">J</span>
      </div>
      <span class="font-bold text-xl text-white tracking-tight hidden sm:block">
        Josh Giles
      </span>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden md:flex items-center gap-8">
      {navItems.map(item => (
        <a
          href={item.href}
          class="text-sm font-medium text-gray-400 hover:text-white transition-colors duration-200 relative group"
        >
          {item.label}
          <span class="absolute -bottom-1 left-0 w-0 h-0.5 bg-amber-500 group-hover:w-full transition-all duration-300"></span>
        </a>
      ))}
    </nav>

    <!-- CTA Button (Desktop) -->
    <div class="hidden md:block">
      <a
        href="mailto:hello@joshgiles.dev"
        class="px-5 py-2 text-sm font-medium text-slate-900 bg-amber-500 rounded-lg hover:bg-amber-400 transition-colors duration-200"
      >
        Get in touch
      </a>
    </div>

    <!-- Mobile Menu Button -->
    <button
      id="mobile-menu-btn"
      class="md:hidden p-2 rounded-lg text-gray-400 hover:text-white hover:bg-slate-800 transition-colors focus:outline-none focus:ring-2 focus:ring-amber-500/50"
      aria-label="Toggle menu"
    >
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </div>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="hidden md:hidden bg-slate-900 border-t border-slate-800">
    <div class="container mx-auto px-4 py-4 space-y-1">
      {navItems.map(item => (
        <a
          href={item.href}
          class="block px-4 py-3 text-base font-medium text-gray-400 rounded-lg hover:bg-slate-800 hover:text-white transition-colors"
        >
          {item.label}
        </a>
      ))}
      <div class="pt-4 mt-4 border-t border-slate-800">
        <a
          href="mailto:hello@joshgiles.dev"
          class="block w-full px-4 py-3 text-center text-sm font-medium text-slate-900 bg-amber-500 rounded-lg hover:bg-amber-400 transition-colors"
        >
          Get in touch
        </a>
      </div>
    </div>
  </div>
</header>

<!-- Spacer for fixed header -->
<div class="h-16"></div>

<script>
  const mobileBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');

  if (mobileBtn && mobileMenu) {
    mobileBtn.addEventListener('click', () => {
      mobileMenu.classList.toggle('hidden');
    });
  }
</script>
