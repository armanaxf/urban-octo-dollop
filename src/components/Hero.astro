---
// Hero section - Freelancer style inspired by the reference design
---

<section class="relative w-full min-h-[90vh] flex items-center bg-slate-900 overflow-hidden">
  <!-- Subtle gradient background -->
  <div class="absolute inset-0 bg-gradient-to-br from-slate-900 via-slate-800/50 to-slate-900"></div>

  <!-- Grid pattern overlay (subtle) -->
  <div class="absolute inset-0 opacity-[0.02]" style="background-image: url('data:image/svg+xml,%3Csvg width=\"60\" height=\"60\" viewBox=\"0 0 60 60\" xmlns=\"http://www.w3.org/2000/svg\"%3E%3Cg fill=\"none\" fill-rule=\"evenodd\"%3E%3Cg fill=\"%23ffffff\" fill-opacity=\"1\"%3E%3Cpath d=\"M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z\"/%3E%3C/g%3E%3C/g%3E%3C/svg%3E');"></div>

  <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-6xl relative z-10">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">

      <!-- Left Column - Personal Info -->
      <div class="animate-fade-in">
        <!-- Social Links -->
        <div class="flex items-center gap-4 mb-8">
          <a
            href="https://github.com/armanaxf"
            target="_blank"
            rel="noopener noreferrer"
            class="w-10 h-10 rounded-full bg-slate-800 border border-slate-700 flex items-center justify-center text-gray-400 hover:text-white hover:border-amber-500 transition-all duration-300"
            aria-label="GitHub"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
            </svg>
          </a>
          <a
            href="https://www.linkedin.com/in/josh-giles-41248885/"
            target="_blank"
            rel="noopener noreferrer"
            class="w-10 h-10 rounded-full bg-slate-800 border border-slate-700 flex items-center justify-center text-gray-400 hover:text-white hover:border-amber-500 transition-all duration-300"
            aria-label="LinkedIn"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
            </svg>
          </a>
        </div>

        <!-- Name -->
        <h1 class="text-5xl sm:text-6xl lg:text-7xl font-bold text-white mb-2 leading-none tracking-tight">
          Josh
          <br />
          <span class="relative">
            Giles<span class="text-amber-500">.</span>
            <span class="absolute -bottom-2 left-0 w-16 h-1 bg-amber-500 rounded-full"></span>
          </span>
        </h1>
      </div>

      <!-- Right Column - Introduction -->
      <div class="animate-slide-up delay-200">
        <!-- Navigation hint -->
        <nav class="flex items-center gap-6 mb-8 text-sm">
          <a href="#services" class="nav-link-active text-amber-500 flex items-center gap-1">
            Services
            <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>
          </a>
          <a href="#portfolio" class="nav-link">Works</a>
          <a href="/posts" class="nav-link">Blog</a>
        </nav>

        <!-- Introduction Label -->
        <p class="section-label flex items-center gap-2">
          <span class="w-4 h-px bg-gray-600"></span>
          Introduction
        </p>

        <!-- Title -->
        <h2 class="text-2xl sm:text-3xl font-semibold text-white mb-4">
          AI Developer and Consultant, based in Scotland.
        </h2>

        <!-- Description -->
        <p class="text-gray-400 leading-relaxed mb-6">
          I help businesses leverage artificial intelligence and modern technology to solve complex problems,
          automate workflows, and build intelligent solutions that drive real results.
        </p>

        <!-- CTA -->
        <a href="/about" class="text-amber-link font-medium">
          My story
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>
    </div>
  </div>

  <!-- Scroll Indicator -->
  <div class="absolute bottom-8 left-1/2 transform -translate-x-1/2 animate-bounce">
    <svg class="w-5 h-5 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
    </svg>
  </div>
</section>
