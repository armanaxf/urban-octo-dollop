---
const year = new Date().getFullYear();
---

<footer class="bg-warm-50 border-t border-warm-200 py-16">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-6xl">
    <!-- CTA Section -->
    <div class="text-center mb-16">
      <h2 class="text-3xl sm:text-4xl font-bold text-warm-900 mb-4">
        Let's make something<br />
        <span class="text-coral-500">amazing together.</span>
      </h2>
      <p class="text-warm-600 mb-6 max-w-md mx-auto">
        Have a project in mind? Let's discuss how I can help bring your ideas to life.
      </p>
      <a href="mailto:hello@joshgiles.dev" class="text-coral-link text-lg">
        Start by saying hi
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    </div>

    <div class="grid md:grid-cols-4 gap-8 mb-12">
      <!-- Brand -->
      <div class="md:col-span-2">
        <a href="/" class="inline-block mb-4">
          <span class="font-script text-4xl text-warm-900">Josh</span>
        </a>
        <p class="text-warm-600 text-sm leading-relaxed max-w-sm">
          AI Developer & Consultant based in Scotland. I help businesses leverage artificial intelligence to solve complex problems.
        </p>
      </div>

      <!-- Quick Links -->
      <div>
        <h4 class="text-warm-900 font-semibold mb-4 text-sm uppercase tracking-wide">Navigate</h4>
        <ul class="space-y-2">
          <li><a href="/" class="text-warm-600 hover:text-coral-500 transition-colors text-sm">Services</a></li>
          <li><a href="/posts" class="text-warm-600 hover:text-coral-500 transition-colors text-sm">Works</a></li>
          <li><a href="/posts" class="text-warm-600 hover:text-coral-500 transition-colors text-sm">Notes</a></li>
          <li><a href="/about" class="text-warm-600 hover:text-coral-500 transition-colors text-sm">Experience</a></li>
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <h4 class="text-warm-900 font-semibold mb-4 text-sm uppercase tracking-wide">Information</h4>
        <ul class="space-y-2 text-sm text-warm-600">
          <li>Scotland, UK</li>
          <li>
            <a href="mailto:hello@joshgiles.dev" class="hover:text-coral-500 transition-colors">
              hello@joshgiles.dev
            </a>
          </li>
        </ul>

        <!-- Social Links -->
        <div class="flex gap-3 mt-4">
          <a
            href="https://github.com/armanaxf"
            target="_blank"
            rel="noopener noreferrer"
            class="w-9 h-9 rounded-full bg-warm-200 flex items-center justify-center text-warm-600 hover:bg-coral-500 hover:text-white transition-all duration-300"
            aria-label="GitHub"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
            </svg>
          </a>
          <a
            href="https://www.linkedin.com/in/josh-giles-41248885/"
            target="_blank"
            rel="noopener noreferrer"
            class="w-9 h-9 rounded-full bg-warm-200 flex items-center justify-center text-warm-600 hover:bg-coral-500 hover:text-white transition-all duration-300"
            aria-label="LinkedIn"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
            </svg>
          </a>
        </div>
      </div>
    </div>

    <!-- Copyright -->
    <div class="pt-8 border-t border-warm-200 flex flex-col sm:flex-row justify-between items-center gap-4">
      <p class="text-sm text-warm-500">
        &copy; {year} Josh Giles. All rights reserved.
      </p>
      <p class="text-xs text-warm-400">
        Design by Josh Creative Agency
      </p>
    </div>
  </div>
</footer>
