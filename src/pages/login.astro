---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import { verifyPassword, createSessionToken, checkRateLimit } from '../lib/auth';

let error = '';

if (Astro.request.method === 'POST') {
    const clientIp = Astro.clientAddress;
    const rateLimit = checkRateLimit(clientIp);

    if (!rateLimit.allowed) {
        error = `Too many attempts. Please try again in ${rateLimit.waitTime} minutes.`;
    } else {
        const formData = await Astro.request.formData();
        const password = formData.get('password')?.toString() || '';

        if (verifyPassword(password)) {
            const token = createSessionToken({
                username: 'admin',
                createdAt: Date.now(),
            });

            Astro.cookies.set('session', token, {
                httpOnly: true,
                secure: import.meta.env.PROD,
                sameSite: 'lax',
                path: '/',
                maxAge: 60 * 60 * 24, // 24 hours
            });

            return Astro.redirect('/admin');
        } else {
            error = 'Invalid password';
        }
    }
}

// Redirect if already logged in
if (Astro.locals.session) {
    return Astro.redirect('/admin');
}
---

<Layout title="Login | Josh Giles">
    <div class="min-h-[60vh] flex items-center justify-center">
        <div class="w-full max-w-md">
            <div class="bg-warm-50 rounded-2xl shadow-lg p-8 border border-warm-200">
                <div class="text-center mb-8">
                    <div class="w-12 h-12 mx-auto rounded-xl bg-coral-500 flex items-center justify-center mb-4">
                        <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                        </svg>
                    </div>
                    <h1 class="text-2xl font-bold text-warm-900">
                        Admin Login
                    </h1>
                    <p class="text-warm-500 mt-2 text-sm">
                        Enter your password to continue
                    </p>
                </div>

                {error && (
                    <div class="mb-6 p-4 bg-red-50 border border-red-200 rounded-xl text-red-600 text-sm">
                        {error}
                    </div>
                )}

                <form method="POST" class="space-y-6">
                    <div>
                        <label for="password" class="block text-sm font-medium text-warm-700 mb-2">
                            Password
                        </label>
                        <input
                            type="password"
                            id="password"
                            name="password"
                            required
                            class="w-full px-4 py-3 rounded-xl border border-warm-300 bg-white text-warm-900 placeholder-warm-400 focus:ring-2 focus:ring-coral-500 focus:border-transparent transition-all duration-200"
                            placeholder="Enter admin password"
                        />
                    </div>

                    <button
                        type="submit"
                        class="w-full btn-primary"
                    >
                        Sign In
                    </button>
                </form>

                <div class="mt-6 text-center">
                    <a href="/" class="text-sm text-warm-500 hover:text-coral-500 transition-colors">
                        &larr; Back to home
                    </a>
                </div>
            </div>
        </div>
    </div>
</Layout>
