---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Services from '../components/Services.astro';
import Portfolio from '../components/Portfolio.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts'))
  .filter(post => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<Layout title="Josh Giles | AI Developer & Consultant" fullWidth={true}>
  <Hero slot="hero" />

  <!-- Services Section -->
  <Services />

  <!-- Portfolio Section -->
  <Portfolio />

  <!-- Blog Section -->
  <section id="blog" class="py-20 bg-slate-900">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-6xl">
      <!-- Section Header -->
      <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4 mb-12">
        <div>
          <p class="section-label flex items-center gap-2 mb-4">
            <span class="w-4 h-px bg-gray-600"></span>
            Blog
          </p>
          <h2 class="text-3xl sm:text-4xl font-bold text-white">
            Latest Insights &<br />
            <span class="text-gray-400">Tech news.</span>
          </h2>
        </div>
        <a href="/posts" class="text-amber-link font-medium">
          View all posts
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>

      <!-- Blog Posts Grid -->
      <div class="grid md:grid-cols-3 gap-6">
        {posts.map((post, index) => (
          <article
            class="group bg-slate-800 rounded-xl overflow-hidden border border-slate-700/50 hover:border-amber-500/30 transition-all duration-300 hover:-translate-y-1"
            style={`animation: slideUp 0.6s ease-out ${index * 100}ms backwards`}
          >
            <!-- Image or placeholder -->
            {post.data.image ? (
              <div class="aspect-video overflow-hidden">
                <img
                  src={post.data.image}
                  alt={post.data.title}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                />
              </div>
            ) : (
              <div class="aspect-video bg-gradient-to-br from-slate-700 to-slate-800 flex items-center justify-center">
                <svg class="w-12 h-12 text-amber-500/30" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
                </svg>
              </div>
            )}

            <!-- Content -->
            <div class="p-5">
              <div class="flex items-center gap-3 mb-3">
                <time
                  datetime={post.data.date.toISOString()}
                  class="text-xs text-gray-500"
                >
                  {post.data.date.toLocaleDateString('en-US', {
                    month: 'short',
                    day: 'numeric',
                  })}
                </time>
                <span class="text-gray-700">·</span>
                <span class="text-xs text-gray-500">Blog</span>
              </div>

              <h3 class="text-lg font-semibold text-white group-hover:text-amber-500 transition-colors mb-2 line-clamp-2">
                <a href={`/posts/${post.slug}`}>
                  {post.data.title}
                </a>
              </h3>

              <p class="text-sm text-gray-400 line-clamp-2">
                {post.data.description}
              </p>

              <!-- Tags -->
              {post.data.tags && post.data.tags.length > 0 && (
                <div class="flex flex-wrap gap-2 mt-4">
                  {post.data.tags.slice(0, 2).map(tag => (
                    <span class="text-xs px-2 py-1 rounded bg-slate-700/50 text-gray-400">
                      {tag}
                    </span>
                  ))}
                </div>
              )}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-20 bg-slate-800/30">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-4xl text-center">
      <h2 class="text-3xl sm:text-4xl font-bold text-white mb-4">
        Estimate your project?<br />
        <span class="text-amber-500">Let me know here.</span>
      </h2>
      <p class="text-gray-400 mb-8 max-w-xl mx-auto">
        Looking to build an AI solution, automate your workflows, or need expert consultation?
        I'd love to hear about your project.
      </p>
      <a
        href="mailto:hello@joshgiles.dev"
        class="btn-primary inline-flex items-center gap-2"
      >
        Get in touch
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    </div>
  </section>
</Layout>

<style>
  @keyframes slideUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
