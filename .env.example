# Supabase Configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_KEY=your-service-role-secret-key

# Public Supabase keys (accessible in client-side code)
PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Cloudinary (existing)
PUBLIC_CLOUDINARY_CLOUD_NAME=dwc5pxotr
PUBLIC_CLOUDINARY_UPLOAD_PRESET=blog_uploads
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Email Notifications (Resend)
RESEND_API_KEY=re_your_key
ADMIN_EMAIL=your-email@domain.com

# reCAPTCHA (for spam protection)
PUBLIC_RECAPTCHA_SITE_KEY=your-site-key
RECAPTCHA_SECRET_KEY=your-secret-key

# Site URL
SITE=https://yourdomain.com
